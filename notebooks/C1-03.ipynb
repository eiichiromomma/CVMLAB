   "source": [
    "# SymPyでの正弦波の合成\n",
    "CAS含めてSymbolic Mathなツールでの三角関数の扱いは上手くいかないケースが多い。正弦波の合成も振幅が1なら望んだ結果になる。"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "id": "9a79ac32-ebbb-4206-abc9-ba33055e6ea5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\sin{\\left(\\omega t \\right)} + \\cos{\\left(\\omega t \\right)}$"
      ],
      "text/plain": [
       "sin(\\omega*t) + cos(\\omega*t)"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "text/latex": [
       "$\\displaystyle \\sqrt{2} \\sin{\\left(\\omega t + \\frac{\\pi}{4} \\right)}$"
      ],
      "text/plain": [
       "sqrt(2)*sin(\\omega*t + pi/4)"
      ]
     },
     "execution_count": 1,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "from sympy import symbols, sin, pi, simplify\n",
    "t = symbols('t')\n",
    "w = symbols('\\omega')\n",
    "v = sin(w*t)+sin(w*t+pi/2)\n",
    "display(v)\n",
    "simplify(v)"
   ]
  }
 ],
